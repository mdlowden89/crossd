{
  "name": "EventSpark",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Event this spark belongs to (Afterglow)"
    },
    "from_user_id": {
      "type": "string",
      "description": "User sending the spark"
    },
    "to_user_id": {
      "type": "string",
      "description": "User receiving the spark"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "retracted"
      ],
      "default": "active"
    }
  },
  "required": [
    "event_id",
    "from_user_id",
    "to_user_id"
  ]
}